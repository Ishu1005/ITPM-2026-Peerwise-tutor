# Copy to .env — never commit .env

PORT=5000

# Primary DB (Atlas SRV or any Mongo URI)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/peerwise?retryWrites=true&w=majority

# After Atlas fails, try this (Docker: npm run mongo:up in this folder)
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/peerwise

# true = try MONGO_URI_LOCAL when MONGO_URI fails (recommended for dev)
TRY_LOCAL_MONGO_FALLBACK=true

# false = never use embedded Mongo (production should set this or NODE_ENV=production)
# If unset + NODE_ENV is not production, server uses in-memory Mongo when Atlas & local fail.
USE_MEMORY_MONGO=

# MongoDB binary for in-memory fallback (smaller than default 8.x ~700MB+ download)
MONGOMS_VERSION=6.0.14

SESSION_SECRET=change-this-to-a-long-random-secret

# Optional: real SMTP for invoice emails (otherwise Ethereal test inbox in dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# (Client) client/.env — REACT_APP_API_URL=http://localhost:5000
